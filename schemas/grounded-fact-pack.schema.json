{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:repo-artifact:schema:grounded-fact-pack:v1",
  "title": "GroundedFactPack v1/v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "fact_ir_version",
    "repository",
    "commit",
    "entities",
    "facts",
    "evidence_refs",
    "unsupported_areas",
    "limitations"
  ],
  "properties": {
    "fact_ir_version": { "enum": [1, 2] },
    "repository": { "$ref": "#/$defs/repository" },
    "commit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "entities": {
      "type": "array",
      "items": { "$ref": "#/$defs/entity" }
    },
    "facts": {
      "type": "array",
      "items": { "$ref": "#/$defs/fact" }
    },
    "evidence_refs": {
      "type": "array",
      "items": { "$ref": "#/$defs/evidenceRef" }
    },
    "unsupported_areas": {
      "type": "array",
      "items": { "$ref": "#/$defs/unsupportedArea" }
    },
    "limitations": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": { "fact_ir_version": { "const": 1 } },
        "required": ["fact_ir_version"]
      },
      "then": {
        "properties": {
          "facts": {
            "items": {
              "not": {
                "properties": { "fact_type": { "const": "CALL_RELATION" } },
                "required": ["fact_type"]
              }
            }
          },
          "evidence_refs": {
            "items": {
              "not": {
                "properties": { "evidence_type": { "const": "direct_call" } },
                "required": ["evidence_type"]
              }
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "repository": {
      "type": "object",
      "additionalProperties": false,
      "required": ["url", "owner", "name"],
      "properties": {
        "url": { "type": "string", "format": "uri" },
        "owner": { "type": "string", "minLength": 1 },
        "name": { "type": "string", "minLength": 1 }
      }
    },
    "symbol": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "qualified_name": { "type": "string", "minLength": 1 },
        "kind": {
          "enum": [
            "function",
            "method",
            "class",
            "interface",
            "type",
            "module",
            "variable",
            "constant",
            "other"
          ]
        }
      }
    },
    "conditionTerm": {
      "type": "object",
      "additionalProperties": false,
      "required": ["left", "operator", "right"],
      "properties": {
        "left": { "type": "string", "minLength": 1 },
        "operator": { "const": "EQUALS" },
        "right": { "type": ["string", "null"] }
      }
    },
    "nullishConditionExpression": {
      "type": "object",
      "additionalProperties": false,
      "required": ["operator", "terms"],
      "properties": {
        "operator": { "const": "OR" },
        "terms": {
          "type": "array",
          "minItems": 2,
          "items": { "$ref": "#/$defs/conditionTerm" }
        }
      }
    },
    "arrayConditionTerm": {
      "type": "object",
      "additionalProperties": false,
      "required": ["operand", "predicate"],
      "properties": {
        "operand": { "type": "string", "minLength": 1 },
        "predicate": { "const": "IS_ARRAY" }
      }
    },
    "arrayConditionExpression": {
      "type": "object",
      "additionalProperties": false,
      "required": ["operator", "terms"],
      "properties": {
        "operator": { "const": "AND" },
        "terms": {
          "type": "array",
          "minItems": 2,
          "items": { "$ref": "#/$defs/arrayConditionTerm" }
        }
      }
    },
    "conditionExpression": {
      "oneOf": [
        { "$ref": "#/$defs/nullishConditionExpression" },
        { "$ref": "#/$defs/arrayConditionExpression" }
      ]
    },
    "entity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "display_label", "evidence_ids"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "kind": {
          "enum": [
            "package",
            "module",
            "symbol",
            "manifest_field",
            "config_field",
            "condition"
          ]
        },
        "display_label": { "type": "string", "minLength": 1 },
        "source_path": { "type": "string", "minLength": 1 },
        "symbol": { "$ref": "#/$defs/symbol" },
        "field_pointer": { "type": "string", "minLength": 1 },
        "value": {
          "oneOf": [
            { "type": ["string", "number", "boolean", "null"] },
            { "$ref": "#/$defs/conditionExpression" }
          ]
        },
        "evidence_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "verification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "confidence"],
      "properties": {
        "status": { "const": "verified" },
        "confidence": { "const": 1 }
      }
    },
    "qualifier": {
      "type": "object",
      "additionalProperties": false,
      "required": ["key", "value"],
      "properties": {
        "key": {
          "enum": [
            "ACTION",
            "EXPORT_SURFACE",
            "RELATIONSHIP_TYPE",
            "SYMBOL_KIND",
            "CONFIGURATION_FIELD",
            "CONTAINER_RELATION"
          ]
        },
        "value": { "type": "string", "minLength": 1 }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "extractor", "evidence_ids"],
      "properties": {
        "repository": {
          "type": "object",
          "additionalProperties": false,
          "required": ["url", "commit_sha"],
          "properties": {
            "url": { "type": "string", "format": "uri" },
            "commit_sha": { "type": "string", "pattern": "^[0-9a-f]{40}$" }
          }
        },
        "extractor": {
          "enum": [
            "deterministic-evidence-to-fact-v1",
            "deterministic-evidence-to-fact-v2"
          ]
        },
        "evidence_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "fact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "fact_type",
        "category",
        "subject_ref",
        "predicate",
        "object_ref",
        "scope",
        "evidence_ids",
        "source_kind",
        "verification",
        "qualifiers",
        "limitations",
        "provenance"
      ],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "fact_type": {
          "enum": [
            "DECLARATION",
            "TYPE_DECLARATION",
            "EXPORT",
            "IMPORT_RELATION",
            "CALL_RELATION",
            "BRANCH_BEHAVIOR",
            "CONFIGURATION",
            "MODULE_CONTAINS"
          ]
        },
        "category": {
          "enum": ["STRUCTURAL", "BEHAVIORAL", "CONFIGURATION", "TYPE", "RELATION"]
        },
        "subject_ref": { "type": "string", "minLength": 1 },
        "predicate": {
          "enum": [
            "DECLARES",
            "DECLARES_TYPE",
            "EXPORTS",
            "IMPORTS",
            "CALLS",
            "SKIPS_WHEN",
            "CONCATENATES_WHEN",
            "THROWS_WHEN",
            "DECLARES_CONFIGURATION",
            "CONTAINS"
          ]
        },
        "object_ref": { "type": "string", "minLength": 1 },
        "scope": { "enum": ["LOCAL", "MODULE", "PACKAGE"] },
        "evidence_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "source_kind": {
          "enum": [
            "source_code",
            "manifest",
            "configuration",
            "documentation",
            "repository_tree",
            "analysis_reasoning"
          ]
        },
        "verification": { "$ref": "#/$defs/verification" },
        "qualifiers": {
          "type": "array",
          "items": { "$ref": "#/$defs/qualifier" }
        },
        "limitations": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "provenance": { "$ref": "#/$defs/provenance" }
      }
    },
    "evidenceRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "evidence_type", "source_kind", "verification_status"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "evidence_type": {
          "enum": [
            "source_range",
            "symbol_declaration",
            "manifest_field",
            "config_field",
            "documentation_statement",
            "tree_entry",
            "direct_call",
            "reasoned_inference",
            "explanatory_analogy",
            "unresolved"
          ]
        },
        "source_kind": {
          "enum": [
            "source_code",
            "manifest",
            "configuration",
            "documentation",
            "repository_tree",
            "analysis_reasoning"
          ]
        },
        "verification_status": { "const": "verified" },
        "source_path": { "type": "string", "minLength": 1 },
        "blob_sha": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
        "symbol": { "$ref": "#/$defs/symbol" },
        "field_pointer": { "type": "string", "minLength": 1 },
        "line_start": { "type": "integer", "minimum": 1 },
        "line_end": { "type": "integer", "minimum": 1 },
        "excerpt_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
        ,
        "call_relation": {
          "$ref": "urn:repo-artifact:schema:evidence-record:1#/$defs/callRelation"
        }
      }
    },
    "unsupportedArea": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "reason", "evidence_needed"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "reason": { "type": "string", "minLength": 1 },
        "evidence_needed": { "type": "string", "minLength": 1 }
      }
    }
  }
}
