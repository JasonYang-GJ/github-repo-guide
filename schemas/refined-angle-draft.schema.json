{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:repo-artifact:schema:refined-angle-draft:v1",
  "title": "RefinedAngleDraft",
  "type": "object",
  "additionalProperties": false,
  "required": ["refined_angle_draft_version", "status", "repository", "commit", "fact_ir_version", "refined_candidate_id", "base_candidate_id", "base_candidate_fingerprint_sha256", "refinement_selection_id", "title", "editorial_thesis", "supporting_fact_refs", "why_interesting", "target_audience"],
  "properties": {
    "refined_angle_draft_version": { "const": 1 },
    "status": { "const": "DRAFT" },
    "repository": { "$ref": "urn:repo-artifact:schema:grounded-fact-pack:v1#/$defs/repository" },
    "commit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "fact_ir_version": { "const": 1 },
    "refined_candidate_id": { "type": "string", "minLength": 1 },
    "base_candidate_id": { "type": "string", "minLength": 1 },
    "base_candidate_fingerprint_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "refinement_selection_id": { "type": "string", "pattern": "^refinement-selection-[0-9a-f]{16}$" },
    "title": { "type": "string", "minLength": 1, "maxLength": 180 },
    "editorial_thesis": { "type": "string", "minLength": 1, "maxLength": 1200 },
    "supporting_fact_refs": { "type": "array", "minItems": 1, "maxItems": 8, "uniqueItems": true, "items": { "type": "string", "pattern": "^fact_[0-9]{3}$" } },
    "why_interesting": { "type": "string", "minLength": 1, "maxLength": 1200 },
    "target_audience": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "enum": ["DEVELOPER", "AI_ENGINEER", "OPEN_SOURCE_MAINTAINER", "TECH_CREATOR", "GENERAL_TECH"] } },
    "editorial_confidence": { "enum": ["LOW", "MEDIUM", "HIGH"] }
  }
}
