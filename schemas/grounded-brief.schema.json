{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:repo-artifact:schema:grounded-brief:v1",
  "title": "GroundedBrief",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "brief_version",
    "repository",
    "commit",
    "fact_ir_version",
    "brief_plan_version",
    "sections",
    "fact_references",
    "unknowns",
    "limitations",
    "generation_metadata"
  ],
  "properties": {
    "brief_version": { "const": 1 },
    "repository": { "$ref": "#/$defs/repository" },
    "commit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "fact_ir_version": { "enum": [1, 2] },
    "brief_plan_version": { "const": 1 },
    "sections": {
      "type": "array",
      "items": { "$ref": "#/$defs/section" }
    },
    "fact_references": {
      "type": "array",
      "items": { "$ref": "#/$defs/factReference" }
    },
    "unknowns": {
      "type": "array",
      "items": { "$ref": "#/$defs/unknown" }
    },
    "limitations": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "generation_metadata": { "$ref": "#/$defs/generationMetadata" }
  },
  "$defs": {
    "repository": {
      "type": "object",
      "additionalProperties": false,
      "required": ["url", "owner", "name"],
      "properties": {
        "url": { "type": "string", "format": "uri" },
        "owner": { "type": "string", "minLength": 1 },
        "name": { "type": "string", "minLength": 1 }
      }
    },
    "assertion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fact_id", "subject_ref", "predicate", "object_ref"],
      "properties": {
        "fact_id": { "type": "string", "minLength": 1 },
        "subject_ref": { "type": "string", "minLength": 1 },
        "predicate": {
          "enum": [
            "DECLARES",
            "DECLARES_TYPE",
            "EXPORTS",
            "IMPORTS",
            "CALLS",
            "SKIPS_WHEN",
            "CONCATENATES_WHEN",
            "THROWS_WHEN",
            "DECLARES_CONFIGURATION",
            "CONTAINS"
          ]
        },
        "object_ref": { "type": "string", "minLength": 1 }
      }
    },
    "statement": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "text",
        "kind",
        "scope",
        "fact_ids",
        "entity_refs",
        "assertions",
        "unknown_ids",
        "limitations"
      ],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "text": { "type": "string", "minLength": 1 },
        "kind": {
          "enum": [
            "TECHNICAL_FACT",
            "DOCUMENTATION",
            "INFERENCE",
            "TRANSITION",
            "ANALOGY",
            "UNKNOWN"
          ]
        },
        "scope": { "enum": ["LOCAL", "MODULE", "PACKAGE", "PROJECT", "NONE"] },
        "fact_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "entity_refs": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "assertions": {
          "type": "array",
          "items": { "$ref": "#/$defs/assertion" }
        },
        "unknown_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "limitations": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": { "kind": { "const": "TECHNICAL_FACT" } },
            "required": ["kind"]
          },
          "then": {
            "properties": {
              "fact_ids": { "minItems": 1 },
              "assertions": { "minItems": 1 }
            }
          }
        }
      ]
    },
    "section": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "statements"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "title": { "type": "string", "minLength": 1 },
        "statements": {
          "type": "array",
          "items": { "$ref": "#/$defs/statement" }
        }
      }
    },
    "factReference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["statement_id", "fact_ids"],
      "properties": {
        "statement_id": { "type": "string", "minLength": 1 },
        "fact_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "unknown": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "statement", "source_gap_ids", "evidence_needed"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "statement": { "type": "string", "minLength": 1 },
        "source_gap_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "evidence_needed": { "type": "string", "minLength": 1 }
      }
    },
    "generationMetadata": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode",
        "generator",
        "provider",
        "model",
        "paid_api_requests",
        "real_model_requests",
        "repository_executions"
      ],
      "properties": {
        "mode": { "enum": ["deterministic", "model_surface"] },
        "generator": { "type": "string", "minLength": 1 },
        "provider": { "type": ["string", "null"] },
        "model": { "type": ["string", "null"] },
        "paid_api_requests": { "type": "integer", "minimum": 0 },
        "real_model_requests": { "type": "integer", "minimum": 0 },
        "repository_executions": { "type": "integer", "minimum": 0 }
      }
    }
  }
}
