{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:repo-artifact:schema:human-editorial-composition-draft:v1",
  "title": "HumanEditorialCompositionDraft v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["human_editorial_composition_draft_version", "composition_id", "composition_status", "repository", "commit", "fact_ir_version", "host_semantics_version", "neighborhood_id", "neighborhood_fingerprint_sha256", "composer_context_fingerprint_sha256", "source", "title", "editorial_thesis", "why_this_story", "target_audience", "selected_fact_display_ids", "selected_canonical_fact_ids", "selected_known_unknowns", "human_authored", "created_at", "draft_fingerprint_sha256"],
  "properties": {
    "human_editorial_composition_draft_version": { "const": 1 },
    "composition_id": { "type": "string", "pattern": "^composition_[a-z0-9_]+$" },
    "composition_status": { "const": "DRAFT" },
    "repository": { "$ref": "urn:repo-artifact:schema:grounded-fact-pack:v1#/$defs/repository" },
    "commit": { "$ref": "#/$defs/commit" },
    "fact_ir_version": { "enum": [1, 2] },
    "host_semantics_version": { "const": 2 },
    "neighborhood_id": { "type": "string", "pattern": "^neighborhood_[0-9a-f]{16}$" },
    "neighborhood_fingerprint_sha256": { "$ref": "#/$defs/sha256" },
    "composer_context_fingerprint_sha256": { "$ref": "#/$defs/sha256" },
    "source": { "const": "HUMAN" },
    "title": { "type": "string", "minLength": 1 },
    "editorial_thesis": { "type": "string", "minLength": 1 },
    "why_this_story": { "type": "string", "minLength": 1 },
    "target_audience": { "$ref": "#/$defs/nonEmptyStrings" },
    "selected_fact_display_ids": { "type": "array", "minItems": 1, "maxItems": 8, "uniqueItems": true, "items": { "type": "string", "pattern": "^F[1-9][0-9]*$" } },
    "selected_canonical_fact_ids": { "type": "array", "minItems": 1, "maxItems": 8, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
    "selected_known_unknowns": { "type": "array", "uniqueItems": true, "items": { "type": "string", "pattern": "^gap_[a-z0-9_]+$" } },
    "human_authored": { "const": true },
    "created_at": { "type": "string", "format": "date-time" },
    "draft_fingerprint_sha256": { "$ref": "#/$defs/sha256" }
  },
  "$defs": {
    "commit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "nonEmptyStrings": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } }
  }
}
