{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:repo-artifact:schema:evidence-record:1",
  "title": "EvidenceRecord v1/v2",
  "description": "A commit-pinned record describing what supports one repository claim and how that support was checked.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "evidence_record_version",
    "id",
    "claim_id",
    "claim",
    "evidence_type",
    "source_kind",
    "confidence",
    "verification_status",
    "verification",
    "notes",
    "limitations"
  ],
  "properties": {
    "evidence_record_version": {
      "enum": [1, 2]
    },
    "id": {
      "$ref": "#/$defs/id"
    },
    "claim_id": {
      "$ref": "#/$defs/id"
    },
    "claim": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1000
    },
    "evidence_type": {
      "enum": [
        "source_range",
        "symbol_declaration",
        "manifest_field",
        "config_field",
        "documentation_statement",
        "tree_entry",
        "direct_call",
        "reasoned_inference",
        "explanatory_analogy",
        "unresolved"
      ]
    },
    "source_kind": {
      "enum": [
        "source_code",
        "manifest",
        "configuration",
        "documentation",
        "repository_tree",
        "analysis_reasoning"
      ]
    },
    "repository": {
      "$ref": "#/$defs/repository"
    },
    "locator": {
      "$ref": "#/$defs/locator"
    },
    "call_relation": {
      "$ref": "#/$defs/callRelation"
    },
    "supports_evidence_ids": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/id"
      },
      "uniqueItems": true,
      "maxItems": 20,
      "default": []
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "verification_status": {
      "enum": [
        "verified",
        "inferred",
        "documentation",
        "analogy",
        "unknown"
      ]
    },
    "verification": {
      "$ref": "#/$defs/verification"
    },
    "notes": {
      "type": "string",
      "maxLength": 1000
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 500
      },
      "uniqueItems": true,
      "maxItems": 20
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "verification_status": {
            "const": "verified"
          }
        },
        "required": [
          "verification_status"
        ]
      },
      "then": {
        "required": [
          "repository",
          "locator"
        ],
        "properties": {
          "evidence_type": {
            "enum": [
              "source_range",
              "symbol_declaration",
              "manifest_field",
              "config_field",
              "tree_entry",
              "direct_call"
            ]
          },
          "verification": {
            "allOf": [
              {
                "$ref": "#/$defs/verification"
              },
              {
                "properties": {
                  "method": {
                    "enum": [
                      "exact_text",
                      "ast_symbol",
                      "manifest_parse",
                      "config_parse",
                      "tree_lookup",
                      "ast_call_expression"
                    ]
                  },
                  "commit_resolved": {
                    "const": true
                  },
                  "path_exists": {
                    "const": true
                  }
                }
              }
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "verification_status": {
            "const": "documentation"
          }
        },
        "required": [
          "verification_status"
        ]
      },
      "then": {
        "required": [
          "repository",
          "locator"
        ],
        "properties": {
          "evidence_type": {
            "const": "documentation_statement"
          },
          "source_kind": {
            "const": "documentation"
          },
          "verification": {
            "allOf": [
              {
                "$ref": "#/$defs/verification"
              },
              {
                "properties": {
                  "method": {
                    "const": "documentation_read"
                  },
                  "commit_resolved": {
                    "const": true
                  },
                  "path_exists": {
                    "const": true
                  }
                }
              }
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "verification_status": {
            "const": "inferred"
          }
        },
        "required": [
          "verification_status"
        ]
      },
      "then": {
        "required": [
          "supports_evidence_ids"
        ],
        "properties": {
          "evidence_type": {
            "const": "reasoned_inference"
          },
          "source_kind": {
            "const": "analysis_reasoning"
          },
          "supports_evidence_ids": {
            "minItems": 1
          },
          "verification": {
            "allOf": [
              {
                "$ref": "#/$defs/verification"
              },
              {
                "properties": {
                  "method": {
                    "const": "model_inference"
                  }
                }
              }
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "verification_status": {
            "const": "analogy"
          }
        },
        "required": [
          "verification_status"
        ]
      },
      "then": {
        "properties": {
          "evidence_type": {
            "const": "explanatory_analogy"
          },
          "source_kind": {
            "const": "analysis_reasoning"
          },
          "verification": {
            "allOf": [
              {
                "$ref": "#/$defs/verification"
              },
              {
                "properties": {
                  "method": {
                    "const": "analogy_only"
                  }
                }
              }
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "verification_status": {
            "const": "unknown"
          }
        },
        "required": [
          "verification_status"
        ]
      },
      "then": {
        "properties": {
          "evidence_type": {
            "const": "unresolved"
          },
          "source_kind": {
            "const": "analysis_reasoning"
          },
          "verification": {
            "allOf": [
              {
                "$ref": "#/$defs/verification"
              },
              {
                "properties": {
                  "method": {
                    "const": "not_checked"
                  }
                }
              }
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "evidence_type": {
            "const": "source_range"
          }
        },
        "required": [
          "evidence_type"
        ]
      },
      "then": {
        "required": [
          "locator"
        ],
        "properties": {
          "source_kind": {
            "const": "source_code"
          },
          "locator": {
            "allOf": [
              {
                "$ref": "#/$defs/locator"
              },
              {
                "required": [
                  "line_start",
                  "line_end"
                ]
              }
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "evidence_type": {
            "const": "direct_call"
          }
        },
        "required": [
          "evidence_type"
        ]
      },
      "then": {
        "required": [
          "locator",
          "call_relation"
        ],
        "properties": {
          "evidence_record_version": {
            "const": 2
          },
          "source_kind": {
            "const": "source_code"
          },
          "verification": {
            "allOf": [
              {
                "$ref": "#/$defs/verification"
              },
              {
                "properties": {
                  "method": {
                    "const": "ast_call_expression"
                  },
                  "commit_resolved": {
                    "const": true
                  },
                  "path_exists": {
                    "const": true
                  },
                  "symbol_exists": {
                    "const": true
                  },
                  "line_range_valid": {
                    "const": true
                  },
                  "excerpt_matches": {
                    "const": true
                  }
                }
              }
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "evidence_type": {
            "const": "symbol_declaration"
          }
        },
        "required": [
          "evidence_type"
        ]
      },
      "then": {
        "required": [
          "locator"
        ],
        "properties": {
          "source_kind": {
            "const": "source_code"
          },
          "locator": {
            "allOf": [
              {
                "$ref": "#/$defs/locator"
              },
              {
                "required": [
                  "symbol"
                ]
              }
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "evidence_type": {
            "enum": [
              "manifest_field",
              "config_field"
            ]
          }
        },
        "required": [
          "evidence_type"
        ]
      },
      "then": {
        "required": [
          "locator"
        ],
        "properties": {
          "locator": {
            "allOf": [
              {
                "$ref": "#/$defs/locator"
              },
              {
                "required": [
                  "field_pointer"
                ]
              }
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "evidence_type": {
            "const": "manifest_field"
          }
        },
        "required": [
          "evidence_type"
        ]
      },
      "then": {
        "properties": {
          "source_kind": {
            "const": "manifest"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "evidence_type": {
            "const": "config_field"
          }
        },
        "required": [
          "evidence_type"
        ]
      },
      "then": {
        "properties": {
          "source_kind": {
            "const": "configuration"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "evidence_type": {
            "const": "tree_entry"
          }
        },
        "required": [
          "evidence_type"
        ]
      },
      "then": {
        "required": [
          "locator"
        ],
        "properties": {
          "source_kind": {
            "const": "repository_tree"
          }
        }
      }
    }
  ],
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,127}$"
    },
    "repository": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "url",
        "commit_sha"
      ],
      "properties": {
        "url": {
          "type": "string",
          "pattern": "^https://github\\.com/[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+(?:\\.git)?/?$"
        },
        "commit_sha": {
          "type": "string",
          "pattern": "^[a-f0-9]{40}$"
        }
      }
    },
    "symbol": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 300
        },
        "qualified_name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "kind": {
          "enum": [
            "function",
            "method",
            "class",
            "interface",
            "type",
            "module",
            "variable",
            "constant",
            "other"
          ]
        }
      }
    },
    "locator": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_path"
      ],
      "properties": {
        "source_path": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500,
          "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\).+$"
        },
        "blob_sha": {
          "type": "string",
          "pattern": "^[a-f0-9]{40}$"
        },
        "symbol": {
          "$ref": "#/$defs/symbol"
        },
        "line_start": {
          "type": "integer",
          "minimum": 1
        },
        "line_end": {
          "type": "integer",
          "minimum": 1
        },
        "field_pointer": {
          "type": "string",
          "pattern": "^/",
          "maxLength": 500
        },
        "excerpt": {
          "type": "string",
          "maxLength": 1200
        },
        "excerpt_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    },
    "callEndpoint": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_path", "symbol"],
      "properties": {
        "source_path": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500,
          "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\).+$"
        },
        "symbol": { "$ref": "#/$defs/symbol" }
      }
    },
    "callSite": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_path", "line_start", "line_end", "source_order"],
      "properties": {
        "source_path": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500,
          "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\).+$"
        },
        "line_start": { "type": "integer", "minimum": 1 },
        "line_end": { "type": "integer", "minimum": 1 },
        "source_order": { "type": "integer", "minimum": 0 }
      }
    },
    "callImportBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "specifier",
        "local_name",
        "imported_name",
        "declaration_path",
        "line_start",
        "line_end"
      ],
      "properties": {
        "kind": { "enum": ["named", "default", "namespace", "reexport"] },
        "specifier": { "type": "string", "minLength": 1, "maxLength": 500 },
        "local_name": { "type": "string", "minLength": 1, "maxLength": 300 },
        "imported_name": { "type": "string", "minLength": 1, "maxLength": 300 },
        "declaration_path": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500,
          "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\).+$"
        },
        "line_start": { "type": "integer", "minimum": 1 },
        "line_end": { "type": "integer", "minimum": 1 },
        "reexport_hop": { "$ref": "#/$defs/callReexportHop" }
      },
      "allOf": [
        {
          "if": {
            "properties": { "kind": { "const": "reexport" } },
            "required": ["kind"]
          },
          "then": { "required": ["reexport_hop"] }
        }
      ]
    },
    "callReexportHop": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "declaration_path",
        "specifier",
        "exported_name",
        "imported_name",
        "line_start",
        "line_end"
      ],
      "properties": {
        "declaration_path": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500,
          "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\).+$"
        },
        "specifier": { "type": "string", "minLength": 1, "maxLength": 500 },
        "exported_name": { "type": "string", "minLength": 1, "maxLength": 300 },
        "imported_name": { "type": "string", "minLength": 1, "maxLength": 300 },
        "line_start": { "type": "integer", "minimum": 1 },
        "line_end": { "type": "integer", "minimum": 1 }
      }
    },
    "callRelation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "relation",
        "direct",
        "runtime_execution_guaranteed",
        "caller",
        "callee",
        "call_site",
        "resolution_method"
      ],
      "properties": {
        "relation": { "const": "CALLS" },
        "direct": { "const": true },
        "runtime_execution_guaranteed": { "const": false },
        "caller": { "$ref": "#/$defs/callEndpoint" },
        "callee": { "$ref": "#/$defs/callEndpoint" },
        "call_site": { "$ref": "#/$defs/callSite" },
        "resolution_method": {
          "enum": [
            "SAME_FILE",
            "RELATIVE_NAMED_IMPORT",
            "RELATIVE_DEFAULT_IMPORT",
            "RELATIVE_NAMESPACE_IMPORT",
            "RELATIVE_NAMED_REEXPORT"
          ]
        },
        "import_binding": { "$ref": "#/$defs/callImportBinding" }
      }
    },
    "verification": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "method",
        "checked_at",
        "commit_resolved",
        "path_exists",
        "symbol_exists",
        "line_range_valid",
        "excerpt_matches"
      ],
      "properties": {
        "method": {
          "enum": [
            "exact_text",
            "ast_symbol",
            "manifest_parse",
            "config_parse",
            "tree_lookup",
            "ast_call_expression",
            "documentation_read",
            "model_inference",
            "analogy_only",
            "not_checked"
          ]
        },
        "checked_at": {
          "type": "string",
          "format": "date-time"
        },
        "commit_resolved": {
          "type": "boolean"
        },
        "path_exists": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "symbol_exists": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "line_range_valid": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "excerpt_matches": {
          "type": [
            "boolean",
            "null"
          ]
        }
      }
    }
  }
}
