{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:repo-artifact:schema:expression-rewrite-eligibility:v1",
  "title": "ExpressionRewriteEligibility",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "expression_rewrite_eligibility_version",
    "status",
    "source_truth",
    "source_grounded",
    "story_fidelity",
    "approved_story_current",
    "fact_trace_complete",
    "reason_codes",
    "repository",
    "commit",
    "fact_ir_version",
    "approved_story_id",
    "approved_story_fingerprint_sha256",
    "source_script_fingerprint_sha256",
    "allowed_fact_refs",
    "internal_known_unknown_refs",
    "real_model_authorized",
    "eligibility_fingerprint_sha256"
  ],
  "properties": {
    "expression_rewrite_eligibility_version": { "const": 1 },
    "status": { "enum": ["ELIGIBLE", "NOT_ELIGIBLE"] },
    "source_truth": { "enum": ["PASS", "FAIL"] },
    "source_grounded": { "type": "boolean" },
    "story_fidelity": { "enum": ["PASS", "FAIL"] },
    "approved_story_current": { "type": "boolean" },
    "fact_trace_complete": { "type": "boolean" },
    "reason_codes": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
    "repository": { "$ref": "urn:repo-artifact:schema:grounded-fact-pack:v1#/$defs/repository" },
    "commit": { "$ref": "#/$defs/commit" },
    "fact_ir_version": { "enum": [1, 2] },
    "approved_story_id": { "type": "string", "minLength": 1 },
    "approved_story_fingerprint_sha256": { "$ref": "#/$defs/sha256" },
    "source_script_fingerprint_sha256": { "$ref": "#/$defs/sha256" },
    "allowed_fact_refs": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/factRef" } },
    "internal_known_unknown_refs": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/gapRef" } },
    "real_model_authorized": { "const": false },
    "eligibility_fingerprint_sha256": { "$ref": "#/$defs/sha256" }
  },
  "$defs": {
    "commit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "factRef": { "type": "string", "pattern": "^fact_[0-9]{3}$" },
    "gapRef": { "type": "string", "pattern": "^gap_[a-z0-9_]+$" }
  }
}
