{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:repo-artifact:schema:content-angle:1",
  "title": "ContentAngle v1",
  "description": "A ranked, evidence-grounded explanation angle derived only from a validated CodebaseBrief and its evidence.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "content_angle_version",
    "id",
    "brief_id",
    "repository_commit_sha",
    "generated_at",
    "selection_status",
    "rank",
    "category",
    "title",
    "hook",
    "why_interesting",
    "technical_basis",
    "target_audience",
    "claim_ids",
    "evidence_ids",
    "script_safe_claim_ids",
    "confidence",
    "novelty",
    "scores",
    "caveats",
    "selection_reason"
  ],
  "properties": {
    "content_angle_version": {
      "const": 1
    },
    "id": {
      "$ref": "#/$defs/id"
    },
    "brief_id": {
      "$ref": "#/$defs/id"
    },
    "repository_commit_sha": {
      "type": "string",
      "pattern": "^[a-f0-9]{40}$"
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "selection_status": {
      "enum": [
        "candidate",
        "selected",
        "weak",
        "rejected"
      ]
    },
    "rank": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 1,
      "maximum": 3
    },
    "category": {
      "enum": [
        "engineering_insight",
        "architecture_insight",
        "ai_agent_pattern",
        "performance",
        "developer_experience",
        "product_design",
        "unusual_implementation",
        "educational_value"
      ]
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160
    },
    "hook": {
      "type": "string",
      "minLength": 1,
      "maxLength": 400
    },
    "why_interesting": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1200
    },
    "technical_basis": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2000
    },
    "target_audience": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "uniqueItems": true,
      "items": {
        "enum": [
          "beginner_developer",
          "experienced_developer",
          "maintainer",
          "technical_creator",
          "engineering_manager",
          "product_builder",
          "open_source_contributor",
          "general_technical_audience"
        ]
      }
    },
    "claim_ids": {
      "$ref": "#/$defs/non_empty_ids"
    },
    "evidence_ids": {
      "$ref": "#/$defs/non_empty_ids"
    },
    "script_safe_claim_ids": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/id"
      },
      "uniqueItems": true,
      "maxItems": 30
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "novelty": {
      "$ref": "#/$defs/novelty"
    },
    "scores": {
      "$ref": "#/$defs/scores"
    },
    "caveats": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 500
      },
      "uniqueItems": true,
      "maxItems": 20
    },
    "selection_reason": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1000
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "selection_status": {
            "const": "selected"
          }
        },
        "required": [
          "selection_status"
        ]
      },
      "then": {
        "properties": {
          "rank": {
            "type": "integer",
            "minimum": 1,
            "maximum": 3
          },
          "script_safe_claim_ids": {
            "minItems": 1
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "selection_status": {
            "enum": [
              "candidate",
              "weak",
              "rejected"
            ]
          }
        },
        "required": [
          "selection_status"
        ]
      },
      "then": {
        "properties": {
          "rank": {
            "type": "null"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "novelty": {
            "properties": {
              "level": {
                "const": "high"
              }
            },
            "required": [
              "level"
            ]
          }
        },
        "required": [
          "novelty"
        ]
      },
      "then": {
        "properties": {
          "novelty": {
            "allOf": [
              {
                "$ref": "#/$defs/novelty"
              },
              {
                "properties": {
                  "basis": {
                    "const": "external_comparison"
                  },
                  "comparison_sources": {
                    "minItems": 1
                  }
                }
              }
            ]
          }
        }
      }
    }
  ],
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,127}$"
    },
    "non_empty_ids": {
      "type": "array",
      "minItems": 1,
      "maxItems": 50,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/id"
      }
    },
    "novelty": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "level",
        "basis",
        "assessment",
        "comparison_sources"
      ],
      "properties": {
        "level": {
          "enum": [
            "none",
            "low",
            "medium",
            "high",
            "unknown"
          ]
        },
        "basis": {
          "enum": [
            "repository_internal",
            "official_documentation",
            "external_comparison",
            "insufficient_evidence"
          ]
        },
        "assessment": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000
        },
        "comparison_sources": {
          "type": "array",
          "maxItems": 10,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "format": "uri",
            "pattern": "^https://"
          }
        }
      }
    },
    "scores": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "evidence_strength",
        "audience_relevance",
        "teachability",
        "differentiation"
      ],
      "properties": {
        "evidence_strength": {
          "$ref": "#/$defs/score"
        },
        "audience_relevance": {
          "$ref": "#/$defs/score"
        },
        "teachability": {
          "$ref": "#/$defs/score"
        },
        "differentiation": {
          "$ref": "#/$defs/score"
        }
      }
    },
    "score": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    }
  }
}
